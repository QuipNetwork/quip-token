# ==============================================================================
# QuipToken Deployment Configuration
# ==============================================================================
# Copy to .env and fill in before deploying: cp .env.example .env
# ==============================================================================

# Broadcasting account (pays gas). MUST derive the ops EOA compiled into
# `Constants.DEPLOYER` — the CreateX salt is permissioned to that EOA, so it IS
# part of the token address. The deploy script hard-fails before broadcasting if
# this key derives anything else: CreateX would NOT revert, it would silently
# deploy a different token at a different address.
# Real key in the gitignored .env only, never here.
DEPLOYER_PK=

# Owner and LayerZero delegate of the token (public, not a secret). Controls
# peers / enforced options / DVN config only — it cannot mint or move balances.
# Does NOT affect the CREATE3 address. Required (non-zero). Use the multisig.
QUIP_TOKEN_DELEGATE=

# Optional. Private key of the token owner, which must ALSO be the endpoint
# delegate. Only for `make wire-broadcast` (e.g. on testnets where the delegate
# is an EOA). Leave unset for mainnet: `make wire` prints the calls for the
# multisig to execute instead.
DELEGATE_PK=

# NOTE: name, symbol, salt labels, LayerZero endpoints, the home chain and the
# initial supply holder are NOT env: they are compiled into
# script/DeployConstants.sol.

# ------------------------------------------------------------------------------
# RPC endpoints (referenced by foundry.toml [rpc_endpoints] and `make ... RPC=`)
# ------------------------------------------------------------------------------
API_URL_MAINNET=
API_URL_BASE=
API_URL_SEPOLIA=
API_URL_BASE_SEPOLIA=

# Contract verification (Etherscan API V2, multichain key)
ETHERSCAN_API_KEY=
